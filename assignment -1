        "from web3 import Web3\n",
        "\n",
        "print(\"=\" * 40)\n",
        "print(\"          HELLO BLOCKCHAIN\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "RPC_URL = \"https://ethereum-sepolia-rpc.publicnode.com\"\n",
        "\n",
        "web3 = Web3(Web3.HTTPProvider(RPC_URL, request_kwargs={\"timeout\": 15}))\n",
        "\n",
        "if web3.is_connected():\n",
        "    print(\"Blockchain Connection: Successful\")\n",
        "    print(\"Network is ready for interaction.\")\n",
        "    print(\"Chain ID:\", web3.eth.chain_id)\n",
        "else:\n",
        "    print(\"Blockchain Connection: Failed\")\n",
        "    print(\"Please check your internet connection or RPC URL.\")"
